{
    "name": "belovai/scout",
    "description": "Traffic-aware route distance and duration service",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "symfony/console": "^7.3",
        "symfony/dotenv": "^7.3",
        "symfony/framework-bundle": "^7.3",
        "symfony/http-client": "^7.3",
        "symfony/monolog-bundle": "^3.10",
        "symfony/runtime": "^7.3",
        "symfony/yaml": "^7.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^7.3",
        "symfony/css-selector": "^7.3"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "App\\Tests\\": "tests/" }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
